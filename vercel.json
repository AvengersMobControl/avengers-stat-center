{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp?route=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?route=protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?route=authorization-server"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/mcp?route=authorize"
    },
    {
      "source": "/oauth/discord/callback",
      "destination": "/api/mcp?route=discord-callback"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/mcp?route=token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
