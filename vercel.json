{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp?route=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?route=protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?route=authorization-server"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/mcp?route=authorize"
    },
    {
      "source": "/oauth/discord/callback",
      "destination": "/api/mcp?route=discord-callback"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/mcp?route=token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build-site.cjs",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/vercel-ignore-preview.cjs",
  "crons": [
    {
      "path": "/api/discord/result-intake-friday",
      "schedule": "*/5 11-13 * * 5"
    },
    {
      "path": "/api/discord/result-intake-sunday",
      "schedule": "*/5 21-23 * * 0"
    },
    {
      "path": "/api/discord/result-intake-monday",
      "schedule": "*/5 0 * * 1"
    }
  ],
  "functions": {
    "api/discord/result-intake.js": {
      "maxDuration": 60
    },
    "api/discord/result-intake-friday.js": {
      "maxDuration": 60
    },
    "api/discord/result-intake-sunday.js": {
      "maxDuration": 60
    },
    "api/discord/result-intake-monday.js": {
      "maxDuration": 60
    }
  }
}
